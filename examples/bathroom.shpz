material Mirror {
    albedo {
        1;
    }

    roughness {
        0.0;
    }

    metallic {
        1.0;
    }
}

material White {
    albedo {
        vec3(0.9, 0.9, 0.9);
    }

    roughness {
        0.0;
    }

    transmission {
        0.0;
    }
}

material White2 {
    albedo {
        vec3(0.95, 0.9, 0.85);
    }

    roughness {
        hash;
    }

    //clearcoat {
    //    hash;
    //}

    metallic {
        0.2;
    }
}

material WallPaint {
    albedo {
        vec3(0.9, 0.9, 0.2);
    }

    roughness {
        0.0;
    }

    emission {
        vec3(0.9, 0.9, 0.2);
    }
}

material Glass {
    albedo {
        1;
    }

    roughness {
        0.0;
    }

    transmission {
        1.0;
    }
}

material Bricks {
    albedo {
        vec3(1.0, 0.5, 0.5) + (hash - 0.5) * 0.3;
    }
    roughness {
        1;
    }
}

material Wood {
    albedo {
        vec3(0.70, 0.40, 0.20) + (hash - 0.5) * 0.2;
    }
    roughness {
        1;
    }
}

voxel Box size = vec3(5, 3, 5) {

    shape Rect {

        segment Left depth = 1.0 {
            if d <= 0.05 {
                // Back Wall Color
                White;
            } else
            if d < 0.2 {
                // Bricks in the middle
                pattern Bricks {
                    brick {
                        Bricks;
                    }
                    cement {
                        //if d < 0.195 {
                            White;
                        //}
                    }
                } 
            } else
            if d < 0.21 && v > 1.2 && (u > 3.5 || u < 1.5) {
                WallPaint;
            }

            // Place a round mirror centered on the wall
            shape Disc at = vec2(0.5, 0.95), radius = 0.8 {
                if d > 0.20 && d < 0.21 {
                    Mirror;
                }
            }

            if v < 1.2 && d > 0.2 {
                if v > 1.0 && d > 0.35 && d < 0.9 && (u > 1.8 && u < 3.2) {
                    
                } else {         
                    // let relief = u / 0.3;

                    White;

                    if d > 0.9 {
                        let relief = fract(u / 0.3);            
                        if v < 1.0 && relief > 0.1 && relief < 0.8 {
                            Clear;
                        }
                    }
                }
            }
        }
    }

    segment Back depth = 0.2 {
        if v < 2.9 {
            pattern Bricks size = vec2(10, 0.1), gap = 0.09, rounding = 0.0 {
                brick {
                    White2;
                }
                cement {
                    if d < 0.18 {
                        White2;
                    }
                }
            }  
        } else {
            White;
        }            

        // Place a window
        shape Rect at = vec2(0.5, 0.7), size = vec2(2, 1.4) {
            Clear; // Clear window voxels
            if d > 0.096 && d < 0.1 {
                Glass; // Add Glass in the middle
            }
        }
    }

    segment Floor {      

        if_clear {  
            if d >  0.09 {
                pattern Bricks size = vec2(1.2, 0.15), gap = 0.01, rounding = 0.0 {
                    brick {
                        Wood;
                    }
                    cement {
                        Wood;
                    }
                }    
            }  else {
                White;
            } 
        }

        /*
        shape Disc radius = 1.0 {
            if sdf > -0.2 {
                pattern Bricks {
                    brick {
                    White;
                    }
                    cement {
                        Wood;
                    }
                } 
            }
        }*/
    }
}

place Box at = vec3(0, 0, 0);

