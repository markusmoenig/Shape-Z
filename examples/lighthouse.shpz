material Rock {
    albedo {
        mix(vec3(0.4, 0.45, 0.5), vec3(0.6, 0.6, 0.65), hash);
    }
    roughness {
        0.2 + (hash - 0.5) * 0.2;
    }
    metallic {
        1.0;
    }
    specular_tint {
        0.2 + (hash - 0.5) * 0.2;
    }
    clearcoat {
        0.3 + (hash - 0.5) * 0.2;
    }
    clearcoat_gloss {
        0.8 + (hash - 0.5) * 0.15;
    }
}

material LightTowerBody {

    albedo {
        if world.y < 1.0 {
            0.1;
        } else {
            let stripe = floor(world.y / 0.5) % 2;;
            mix(vec3(0.9, 0.1, 0.1), vec3(0.95), stripe);
        }
    }

    roughness {
        0.1;
    }

    transmission {
        0.0;
    }
}

material Water {
    albedo {
        1;
    }

    roughness {
        0.0;
    }

    transmission {
        1.0;
    }

    ior {
        1.33;
    }
}

voxel Rock size = vec3(5, 3, 5) {
    let dist = length(local + vec3(0, 4, 0)) - 2.0;
    dist = min(dist, length(local + vec3(1, 2, 0)) - 1.0);

    // Detail noise
    let n2 = noise_value(4, 3.0);

    // Smooth noise base
    let n1 = noise_value(0, 0.3);

    // Combine both
    let displaced = dist - n1 * 0.2 - n2 * 0.05;

    if displaced < 1.6 {
        Rock;
    }

    // let water_height = sin(local.x * 4.0 + noise_value(2, 1.0) * 3.0) * 0.1
    //              + sin(local.z * 3.0 + noise_value(2, 1.0) * 2.0) * 0.1;

    let water_height = 0.0;

    if local.y < water_height {
        if_clear {
            Water;
        }
    }
}

voxel Tower size = vec3(2, 5, 2) {
    shape Rect {
        segment Floor depth = 5 {
            shape Disc {
                LightTowerBody;
            }
        }
    }
}

place Rock at = vec3(0, 0, 0);
place Tower at = vec3(0.0, 1, 0.0);

